  "divisions": [
    {
      "key": "inti",
      "name": "Inti",
      "description": "Presidium Inti adalah jajaran pimpinan tertinggi atau kelompok pengarah utama dalam suatu organisasi atau lembaga. Mereka berfungsi sebagai pusat koordinasi, pengambil keputusan strategis, dan penggerak arah kebijakan untuk memastikan seluruh program kerja berjalan sesuai visi dan misi.",
      "avatar": "/uploads/1782729492916-3zd6b8.jpeg"
    },
    {
      "key": "psdm",
      "name": "Pengembangan Sumber Daya Manusia (PSDM)",
      "description": "PSDM bertanggung jawab mengoptimalkan, membina, dan mempersiapkan kader, serta fokus pada pengembangan internal, apresiasi, informasi soft skill, dan penguatan solidaritas organisasi.",
      "avatar": "/uploads/1784996601156-d0zn5d.jpeg"
    },
    {
      "key": "kestari",
      "name": "Kesekretariatan (Kestari)",
      "description": "Bidang Kesekretariatan bertanggung jawab atas tugas umum kepengurusan IMK-UNAND, meliputi surat-menyurat, pengarsipan, inventarisasi, serta memfasilitasi penataan dan pengelolaan kegiatan organisasi agar berjalan tertib.",
      "avatar": "/uploads/1784996635578-hacggr.jpeg"
    },
    {
      "key": "kpp",
      "name": "Konseling dan Pemberdayaan Perempuan (KPP)",
      "description": "Bidang KPP mengoordinasikan kegiatan anggota perempuan, menjaga hubungan harmonis antaranggota, serta menyediakan layanan konsultasi dan bantuan untuk penyelesaian masalah. Bidang ini terbagi menjadi dua sub-bidang:\nKonseling: Memberikan solusi atas permasalahan anggota, menjadi wadah aspirasi, dan mencari dukungan.\nPemberdayaan Perempuan: Mendukung upaya pemberdayaan anggota perempuan IMK-UNAND.",
      "avatar": "/uploads/1784996664204-yqgddz.jpeg"
    },
    {
      "key": "infokom",
      "name": "Informasi dan Komunikasi (Infokom)",
      "description": "Bidang INFOKOM bertanggung jawab untuk mengelola, menampung, dan menyampaikan informasi guna memperkuat hubungan internal maupun eksternal serta mempertahankan eksistensi IMK-UNAND di dunia maya. ",
      "avatar": "/uploads/1784996690377-y6i3k5.jpeg"
    },
    {
      "key": "olahraga",
      "name": "Olahraga",
      "description": "Bidang Olahraga berfungsi sebagai wadah untuk mengembangkan minat dan bakat anggota IMK-UNAND. Bidang ini juga berperan sebagai sarana silaturahmi untuk mempererat ikatan persaudaraan antaranggota IMK-UNAND.",
      "avatar": "/uploads/1784996713738-olf1dg.jpeg"
    },
    {
      "key": "danus",
      "name": "Dana dan Usaha (Danus)",
      "description": "Bidang Danus bertanggung jawab mengelola sumber dana organisasi melalui usaha kreatif, kolaboratif, dan sponsorship. Divisi dibagi menjadi Kewirausahaan dan Sponsorship & Kemitraan, namun pelaksanaannya bersifat fleksibel dan saling mendukung.\n",
      "avatar": "/uploads/1784996739322-99fflr.jpeg"
    },
    {
      "key": "sosroh",
      "name": "Sosial dan Rohani (Sosroh)",
      "description": "Bidang Sosroh bertugas mengelola kegiatan sosial dan keagamaan untuk membangun kepedulian, memperkuat nilai rohani, serta menciptakan lingkungan organisasi yang harmonis. Fokus utamanya meliputi donasi, bakti sosial, respon bencana, serta kajian dan peringatan hari besar Islam.",
      "avatar": "/uploads/1784996769294-o0nfc7.jpeg"
    },
    {
      "key": "senbudpar",
      "name": "Seni Budaya dan Pariwisata (Senbudpar)",
      "description": "Bidang ini bertujuan untuk melestarikan adat, budaya, serta memperkenalkan pariwisata dan ekonomi kreatif dari Kota Sungai Penuh dan Kabupaten Kerinci kepada mahasiswa Universitas Andalas. Bidang ini terbagi menjadi dua sub-bidang:\nSeni dan Budaya: Bergerak di bidang seni kebudayaan.\nPariwisata dan Ekonomi Kreatif: Berfokus pada promosi UMKM, komoditi unggulan, dan kuliner tradisional.",
      "avatar": "/uploads/1784996793690-jvenes.jpeg"
    }
  ],
